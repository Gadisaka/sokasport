# API-Football ingestion (API-Sports). Set ENABLE_API_FOOTBALL_CRON=true to run sync jobs on startup.
# API_FOOTBALL_KEY=
# REDIS_URL=redis://localhost:6379
# ENABLE_API_FOOTBALL_CRON=false
#
# DATABASE_URL="mongodb://127.0.0.1:27018/kizzabet?replicaSet=rs0&directConnection=true"

# ─── API-Sports ingestion ────────────────────────────────────────────────
# Comma-separated list of sport slugs to fetch from API-Sports.
# Supported slugs: football, basketball, baseball, hockey, rugby, american-football
# Only currently-subscribed sports should be listed here.
ENABLED_SPORTS=football

# Per-sport API keys (set only the ones you're subscribed to).
API_FOOTBALL_KEY=

# API_BASKETBALL_KEY=
# API_BASEBALL_KEY=
# API_HOCKEY_KEY=
# API_RUGBY_KEY=
# API_AMERICAN_FOOTBALL_KEY=

# Global HTTP tuning for the API-Sports client (optional)
API_SPORTS_TIMEOUT_MS=30000
API_SPORTS_MAX_RETRIES=2
API_SPORTS_DAILY_LIMIT=75000

ENABLE_API_FOOTBALL_CRON=true

# Redis
REDIS_URL=redis://localhost:6379

REDIS_KEY_PREFIX="kizzabet"
API_SPORTS_CACHE_TTL=300


FORCE_BOOTSTRAP=true

ODDS_MAX_FIXTURES_PER_RUN=150
LIVE_POLL_SECONDS=60
ODDS_INTERVAL_SECONDS=180


# Odds ingestion limits
ODDS_MAX_FIXTURES_PER_RUN=250
ODDS_HORIZON_BACKFILL_MAX=2000



# DATABASE_URL="mongodb://127.0.0.1:27018/kizzabet?replicaSet=rs0&directConnection=true"
# REDIS_URL="redis://localhost:6379"


# Odds ingest/query horizon (UTC days). When unset, tracks FIXTURES_DAYS_AHEAD.
# ODDS_HORIZON_DAYS=14
FIXTURES_DAYS_AHEAD=14
ODDS_HORIZON_DAYS=14
# Prefer fixtures kicking off within this many UTC calendar days when ranking odds work (within ODDS_HORIZON_DAYS).
ODDS_NEAR_PRIORITY_DAYS=2

# After admin preferred bookmaker, try these API-Sports bookmaker ids in order (comma-separated).
# When unset, sync uses DEFAULT_BOOKMAKER_FALLBACK_CHAIN (Marathonbet, 1xBet, …) after preferred.
# Do not set to only the preferred id (e.g. 8) — that disables real fallbacks for lower-tier leagues.
BOOKMAKER_FALLBACK_CHAIN=

# Max leagues to store per bulk fixture sync / sidebar regional cap (top active by rank).
INGEST_ACTIVE_CAP=200
SIDEBAR_ACTIVE_CAP=200

# Optional JSON map of api_league_id -> tier (0 = elite). Used to prioritize odds sync under caps.
# LEAGUE_TIERS_JSON={"39": 0, "140": 0, "2": 0, "135": 0, "78": 0, "61": 0, "848": 0, "363": 0, "233": 0, "288": 0, "186": 0, "323": 0, "188": 0, "305": 0, "301": 0, "292": 0}

# When true, list endpoints hide fixtures missing preferred-bookmaker odds. Default false lists fixtures with fallback odds.
PUBLIC_FIXTURES_STRICT_BOOKMAKER=

# -------------------------------------------

# Default min(3, FIXTURES_DAYS_AHEAD). Set to 1 for legacy “today-only” API volume per tick.
FIXTURES_NEAR_WINDOW_DAYS=

# Optional overrides for repeatable cadences (hours). When unset, FIXTURES_TODAY_HOURS / FIXTURES_FUTURE_HOURS apply.
FIXTURES_NEAR_INTERVAL_HOURS=
FIXTURES_DEEP_INTERVAL_HOURS=



# Cloud name
CLOUDINARY_CLOUD_NAME=do3tpe0i7
# API key
CLOUDINARY_API_KEY=794325547962894
# API secret
CLOUDINARY_API_SECRET=oupFHIhbiSzgq93lyLhkTtVE2H0

# API environment variable
