# MongoDB connection string (Atlas/local)
DATABASE_URL="mongodb+srv://USER:PASSWORD@HOST/DATABASE?retryWrites=true&w=majority"

# VPS production Docker: see `.env.production.example` — compose sets DATABASE_URL —
# backend/.env mainly holds JWT + API keys; run via `docker compose -f docker-compose.prod.yml`.

# For Docker dev: use this instead (matches docker-compose.yml)
# DATABASE_URL="mongodb://mongo:27017/kizzabet?replicaSet=rs0&directConnection=true"

# For local replica set (without Docker):
# DATABASE_URL="mongodb://127.0.0.1:27018/kizzabet?replicaSet=rs0"

# Comma-separated browser origins allowed by CORS (production required).
# Example: https://sokasport.com,https://admin.sokasport.com,http://localhost:5173,http://localhost:5174
CORS_ORIGINS="https://sokasport.com,https://admin.sokasport.com"

# Optional single-origin shortcuts (merged into CORS_ORIGINS)
ADMIN_ORIGIN="http://localhost:5174"
FRONTEND_ORIGIN="http://localhost:5173"

JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="1d"
PORT=3001

# --- Redis ---
# Local: redis-server --port 6379
REDIS_URL="redis://localhost:6379"
# For Docker: REDIS_URL="redis://redis:6379"

# Optional namespace/prefix for all cache keys (useful when sharing Redis)
REDIS_KEY_PREFIX="kizzabet"

# --- API-Sports ingestion ---
ENABLED_SPORTS=football
API_FOOTBALL_KEY=
ENABLE_API_FOOTBALL_CRON=false

# Cache upstream API-Sports responses to save daily quota during dev (seconds)
API_SPORTS_CACHE_TTL=300

# Hard cap on upstream calls per day (per sport). The HTTP client will stop
# making new calls once this is reached and resume the next UTC day.
API_SPORTS_DAILY_LIMIT=155000

# --- League rank hierarchy (ingestion + sidebar) ---
# Max leagues to store per bulk fixture sync (top active by rank in Config/leagueRanks.js).
INGEST_ACTIVE_CAP=200
# Max non-top leagues in sidebar catalog; top section (ranks 1–8 + product priority) is separate.
SIDEBAR_ACTIVE_CAP=200

# --- BullMQ worker / scheduler (consumed by `npm run worker`) ---

# Run the legacy node-cron loop inside the API process (single-process dev only).
# Leave unset / "false" in any environment that runs the dedicated worker.
RUN_WORKER_INLINE=false

# Number of future days the bulk fixtures ingestion covers (today..today+N-1).
# Default 14 (code fallback) — aligns with typical prematch UI horizon (max 14 on /fixtures/upcoming).
FIXTURES_DAYS_AHEAD=14

# Default days for GET /fixtures/upcoming when ?days= is omitted (capped by FIXTURES_WINDOW_MAX_DAYS). Code default 14.
# FIXTURES_WINDOW_DEFAULT_DAYS=

# Near-window fixture sync spans UTC offsets [0 .. N-1] at FIXTURES_NEAR_INTERVAL_HOURS (or FIXTURES_TODAY_HOURS).
# Default min(3, FIXTURES_DAYS_AHEAD). Set to 1 for legacy “today-only” API volume per tick.
FIXTURES_NEAR_WINDOW_DAYS=

# Optional overrides for repeatable cadences (hours). When unset, FIXTURES_TODAY_HOURS / FIXTURES_FUTURE_HOURS apply.
FIXTURES_NEAR_INTERVAL_HOURS=
FIXTURES_DEEP_INTERVAL_HOURS=

# Lookback sync: re-fetch recent past days to catch fixtures whose status was missed
# (e.g. match ended after UTC midnight rollover). Default 2 days behind, every 4 hours.
FIXTURES_DAYS_BEHIND=2
FIXTURES_LOOKBACK_INTERVAL_HOURS=4

# Cadence of repeatable jobs (overrides applied by `queues/scheduler.js`).
# Values are integers in their named unit (no fractional values).
FIXTURES_TODAY_HOURS=2
FIXTURES_FUTURE_HOURS=6
LEAGUES_META_DAYS=7
LIVE_POLL_SECONDS=30
ODDS_INTERVAL_SECONDS=120

# --- Odds ingestion limits ---
# Per-tick cap for the 2-minute repeatable odds job. Keep low to avoid
# blocking other queue work; fixtures without markets are prioritized.
ODDS_MAX_FIXTURES_PER_RUN=250

# Cap per backfill pass. After each fixture-bulk sync, ODDS_BACKFILL_PASSES
# jobs are queued (each processing up to this many fixtures). Total coverage
# per cycle = ODDS_HORIZON_BACKFILL_MAX × ODDS_BACKFILL_PASSES.
ODDS_HORIZON_BACKFILL_MAX=500

# Number of sequential backfill passes enqueued after each fixture-bulk sync.
# Default 3 → up to 1500 fixtures' odds per 6-hour cycle (3 × 500).
ODDS_BACKFILL_PASSES=3

# Odds ingest/query horizon (UTC days). When unset, tracks FIXTURES_DAYS_AHEAD.
# Set to 14 explicitly to match the prematch UI horizon.
ODDS_HORIZON_DAYS=

# Bulk `/odds?date=` sweep across the full horizon (default on).
# Set ODDS_BULK_BY_DATE_ENABLED=false to revert to per-fixture backfill passes.
ODDS_BULK_BY_DATE_ENABLED=true
# Hours between scheduled bulk sweeps (matches upstream ~3h odds refresh).
ODDS_BULK_INTERVAL_HOURS=3
# Cap pages walked per date (upstream returns 10 fixtures/page).
ODDS_BULK_MAX_PAGES_PER_DATE=100
# Delay between bulk odds pages (ms).
ODDS_BULK_PAGE_DELAY_MS=400

# Prefer fixtures kicking off within this many UTC calendar days when ranking
# odds work (within ODDS_HORIZON_DAYS). Backfill passes ignore this and
# process the full horizon chronologically.
ODDS_NEAR_PRIORITY_DAYS=

# GET /odds/:apiFixtureId expand payload caps (warm DB read + cold hydrate response).
# Frontend only needs value/odd lines — bookmaker join is omitted.
ODDS_DETAIL_MARKET_LIMIT=24
ODDS_DETAIL_ODD_LINE_LIMIT=80

# After admin preferred bookmaker, try these API-Sports bookmaker ids in order (comma-separated).
# When unset, sync uses DEFAULT_BOOKMAKER_FALLBACK_CHAIN (Marathonbet, 1xBet, …) after preferred.
# Example override: BOOKMAKER_FALLBACK_CHAIN=2,11,16,34,32,3
BOOKMAKER_FALLBACK_CHAIN=

# Optional JSON map of api_league_id -> tier (0 = elite). Used to prioritize odds sync under caps.
# When unset, odds sync uses league rank from Config/leagueRanks.js.
LEAGUE_TIERS_JSON=

# When true, list endpoints hide fixtures missing preferred-bookmaker odds. Default false lists fixtures with fallback odds.
PUBLIC_FIXTURES_STRICT_BOOKMAKER=

# --- Odds filtering (NEW: write-volume reduction) ---
# Single-bookmaker policy: by default odds writes are restricted to the
# bookmaker selected in the admin UI ("Preferred Bookmaker" page). When
# no admin preference is set yet, this env provides a fallback so ops
# can enable filtering before the UI is configured.
# Example: 8 = Bet365 (API-Sports api_bookmaker_id).
# Leave unset to keep legacy "persist every bookmaker" behavior.
DEFAULT_BOOKMAKER_API_ID=

# Optional comma-separated allowlist of market names to persist. When
# unset (default), every market the upstream returns is persisted –
# this keeps `/odds/:apiFixtureId` and `/fixtures/today` returning the
# same "extras"/sideBets data the frontend already shows. Enable only
# after confirming the trim is acceptable for the UI.
# Example: ODDS_ALLOWED_MARKETS=Match Winner,Goals Over/Under,Both Teams Score,Double Chance
ODDS_ALLOWED_MARKETS=

# Force a boot-time bulk fixtures job even when the DB already has horizon data.
# Useful after wiping the DB or changing allowlists; leave "false" normally.
FORCE_BOOTSTRAP=false

# Legacy cashier POST /api/tickets verifies every submitted leg's odds against
# the admin-managed Odd table (fail-closed on missing/disabled/drifted price).
# Set to false to restore the old trust-the-client behavior.
# CASHIER_TICKET_ODDS_VERIFY=true

# --- Performance diagnostics ---
# PERF_TIMING=1 logs per-request span breakdowns to stdout (place-bet, print, etc.).
# PLACE_BET_SLOW_MS=1000 warns when POST /api/bets/place exceeds this threshold.
# PERF_TIMING=1
# PLACE_BET_SLOW_MS=1000

# --- Live-bet acceptance hardening ---
# LIVE_ACCEPTANCE_DELAY_MS=2500
# LIVE_HOLD_MAX_CONCURRENT=150
# LIVE_HOLD_FAIL_CLOSED=true
# ALLOW_ANON_LIVE_COUPONS=false
# HELD_TICKET_REAPER_DEADLINE_MS=15000
# HOLD_REAPER_SECONDS=20
# HOLD_REAPER_BATCH=100

# --- InOut Games (seamless wallet casino) ---
# Operator ID (UUID) issued by InOut for this environment.
INOUT_OPERATOR_ID=
# HMAC-SHA256 key used to verify inbound webhook signatures (X-REQUEST-SIGN).
# SECRET — do not commit.
INOUT_SIGNATURE_KEY=
# Base URL for the game launch endpoint (default shown).
INOUT_LAUNCH_BASE_URL=https://api.inout.games/api/launch
# Base URL for InOut REST endpoints (gameModesList catalog sync). Default shown.
INOUT_API_BASE_URL=https://api.inout.games/api
# Demo/spectator operator id from InOut frontend docs (default shown).
INOUT_DEMO_OPERATOR_ID=ee2013ed-e1f0-4d6e-97d2-f36619e2eb52
# Default player currency for launch + webhooks.
INOUT_DEFAULT_CURRENCY=ETB
# Default ISO country code for launch URLs (InOut requires userCountryCode).
INOUT_DEFAULT_COUNTRY=ET
# Optional label from InOut onboarding.
INOUT_ALIAS=sokasport-prod

# --- MRX Instant Games (SSO + wallet bridge) ---
# AES-256 key material as 64 hex chars (first 64 hex → 32-byte key). Must match MRX.
MRX_ENCRYPTION_KEY=
# Shared secret for POST /api/internal/wallet/adjust-balance (x-api-key). Must match MRX.
INTERNAL_BRIDGE_KEY=
